# Postgres. Neon's free tier is more than enough for a group of a dozen.
# On Vercel, enabling the Neon integration sets both of these for you - pull
# them down with: vercel env pull .env.local
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional, Neon only: the direct (non-pooled) endpoint. Migrations use it when
# set, because DDL through a transaction pooler is asking for trouble. Leave it
# blank on a plain local Postgres - DATABASE_URL is then used for both.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
# AUTH_SECRET / AUTH_URL are still read as a fallback if you already set those.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend, for magic-link sign-in and deadline reminders.
RESEND_API_KEY=""
EMAIL_FROM="Secret Santa Shirts <santa@yourdomain.com>"

# AI image generation. Set ONE of these.
#
# Vercel AI Gateway is the one to use for a deployment: same model, but the
# spend cap and the usage dashboard live in Vercel, so there is a hard ceiling
# on the bill rather than only the per-person generation cap in our own code.
# Set it in the Vercel dashboard - there is no budget setting in this repo.
# AI_GATEWAY_API_KEY=""

# OpenAI direct. Simpler for local development, no spend ceiling.
OPENAI_API_KEY=""

# fal, for background removal (BiRefNet) and upscaling.
FAL_KEY=""

# Vercel Blob, for design and print-file storage.
BLOB_READ_WRITE_TOKEN=""

# Shared secret so only Vercel Cron can trigger reminder emails.
CRON_SECRET=""
