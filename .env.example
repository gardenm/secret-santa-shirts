# Postgres. Neon's free tier is more than enough for a group of a dozen.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
# AUTH_SECRET / AUTH_URL are still read as a fallback if you already set those.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend, for magic-link sign-in and deadline reminders.
RESEND_API_KEY=""
EMAIL_FROM="Secret Santa Shirts <santa@yourdomain.com>"

# OpenAI, for AI image generation.
OPENAI_API_KEY=""

# fal, for background removal (BiRefNet) and upscaling.
FAL_KEY=""

# Vercel Blob, for design and print-file storage.
BLOB_READ_WRITE_TOKEN=""

# Shared secret so only Vercel Cron can trigger reminder emails.
CRON_SECRET=""
